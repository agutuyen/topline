<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Block access to hidden, sensitive configuration and database files
  RewriteRule (^|/)\.(git|env|cache|htaccess) - [F,L]
  RewriteRule \.(db|sqlite|sqlite3|sql|log|md|bak|swp)$ - [F,L]

  # Don't rewrite if request is already targeting dist/
  RewriteCond %{REQUEST_URI} ^/dist/ [NC]
  RewriteRule ^ - [L]

  # If the requested file or directory exists in dist/, serve it from dist/
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f [OR]
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -d
  RewriteRule ^(.*)$ /dist/$1 [L]

  # Otherwise, route all requests to /dist/index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.*)$ /dist/index.html [L]
</IfModule>

# 2. Security Headers (Harden HTTP response)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# 3. MIME Types Configuration
<IfModule mod_mime.c>
  AddType text/javascript .js
  AddType text/javascript .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
  AddType video/mp4 .mp4
</IfModule>

# 4. Gzip & Deflate Compression for Speed & Bandwidth
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json
</IfModule>
