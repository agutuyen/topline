# ==============================================================
# TOPLINE HOSPITALITY FURNITURE — ENVIRONMENT CONFIGURATION
# ==============================================================

# Server & Network Ports
PORT=3000
API_PORT=3001
NODE_ENV=production

# Security & Session Authentication
# IMPORTANT: Generate a strong 64-character secret in production (e.g. openssl rand -hex 32)
JWT_SECRET=topline_furniture_secret_jwt_key_2026_contract_luxury_change_in_production

# Database Configuration
# Options: 'sqlite' (default, zero-config data/topline.db) or 'mariadb' (host/cPanel)
DB_TYPE=sqlite

# MariaDB / MySQL Configuration (Only needed when DB_TYPE=mariadb)
DB_HOST=localhost
DB_PORT=3306
DB_USER=topline_user
DB_PASSWORD=your_secure_password
DB_NAME=topline_db

# File Upload Configuration
UPLOAD_MAX_SIZE=26214400 # 25MB in bytes

# Gemini AI API Configuration (Optional)
GEMINI_API_KEY=""
APP_URL=""
